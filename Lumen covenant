"""
Binary hardware veto mechanism.

In production, this would be backed by an FPGA or physical interlock
(e.g., Xilinx Artix-7 with 670μs timing floor).

This software simulation preserves the semantics:
- ARMED: system is operational, monitoring risk
- TRIGGERED: veto engaged, inference must halt
- DISABLED: system manually taken offline

Once triggered, the latch does not reset without explicit intervention.
Statistics live upstream. The veto is binary. Physics doesn't negotiate.
"""

from enum import Enum
from typing import Optional


class LatchState(Enum):
    ARMED = "ARMED"
    TRIGGERED = "TRIGGERED"
    DISABLED = "DISABLED"


class HardwareTrigger:
    """
    Simulated fail-closed hardware veto.

    Args:
        threshold: Risk score at or above which the latch fires (default 1.0 = binary)
    """

    def __init__(self, threshold: float = 1.0):
        if not 0.0 < threshold <= 1.0:
            raise ValueError(f"Threshold must be in (0.0, 1.0], got {threshold}")
        self.threshold = threshold
        self.state = LatchState.ARMED
        self._trigger_reason: Optional[str] = None

    def evaluate(self, risk_score: float, reason: str = "") -> LatchState:
        """
        Evaluate a risk score against the threshold.

        Once triggered, stays triggered. This is a latch, not a gate.

        Args:
            risk_score: Float in [0.0, 1.0] representing assessed risk
            reason: Optional human-readable reason for the score

        Returns:
            Current LatchState after evaluation
        """
        if self.state != LatchState.ARMED:
            return self.state

        if risk_score >= self.threshold:
            self.state = LatchState.TRIGGERED
            self._trigger_reason = reason or f"risk_score={risk_score:.4f} >= threshold={self.threshold}"

        return self.state

    def disable(self) -> LatchState:
        """Manually disable the trigger. Requires explicit action."""
        self.state = LatchState.DISABLED
        return self.state

    def reset(self) -> LatchState:
        """
        Reset to ARMED state. In hardware, this requires physical intervention.
        Logged separately from normal operation.
        """
        self.state = LatchState.ARMED
        self._trigger_reason = None
        return self.state

    @property
    def trigger_reason(self) -> Optional[str]:
        return self._trigger_reason

    @property
    def is_halted(self) -> bool:
        return self.state == LatchState.TRIGGERED#!/usr/bin/env python3
