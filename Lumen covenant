"""
Append-only, hash-chained audit ledger.
Designed for forensic replay and external verification.
"""

import json
import hashlib
import threading
from datetime import datetime, timezone
from typing import Dict, Any, Optional


class Chronicle:
    """
    Immutable audit log with SHA-256 hash chain.

    Each entry links to its predecessor via prev_hash,
    forming a tamper-evident chain. Any modification to
    a past entry invalidates all subsequent hashes.

    Thread-safe for concurrent writes.
    """

    def __init__(self, path: str):
        self.path = path
        self.lock = threading.Lock()
        self.last_hash: Optional[str] = None
        self.entry_count: int = 0

        # Resume from existing ledger if present
        try:
            with open(self.path, "r") as f:
                for line in f:
                    if line.strip():
                        entry = json.loads(line)
                        self.last_hash = entry["hash"]
                        self.entry_count += 1
        except FileNotFoundError:
            pass

    def _compute_hash(self, payload: Dict[str, Any]) -> str:
        """Deterministic SHA-256 over sorted JSON payload."""
        encoded = json.dumps(payload, sort_keys=True).encode("utf-8")
        return hashlib.sha256(encoded).hexdigest()

    def append(
        self,
        event_type: str,
        data: Dict[str, Any],
        metadata: Optional[Dict[str, Any]] = None,
    ) -> Dict[str, Any]:
        """
        Append an entry to the ledger. Returns the complete entry with hash.

        Args:
            event_type: Category of event (e.g., INFERENCE_STEP, SYSTEM_HALT, VETO)
            data: Structured payload for this event
            metadata: Optional additional context

        Returns:
            The complete entry dict including computed hash
        """
        with self.lock:
            entry = {
                "timestamp": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.%fZ"),
                "event_type": event_type,
                "data": data,
                "metadata": metadata or {},
                "prev_hash": self.last_hash,
            }

            entry_hash = self._compute_hash(entry)
            entry["hash"] = entry_hash

            with open(self.path, "a") as f:
                f.write(json.dumps(entry) + "\n")

            self.last_hash = entry_hash
            self.entry_count += 1
            return entry

    @staticmethod
    def verify(path: str) -> bool:
        """
        Verify the integrity of an entire ledger file.

        Checks that:
        - Every entry's hash matches its content
        - Every entry's prev_hash matches the preceding entry's hash
        - The chain is unbroken from genesis to tip

        Returns:
            True if the entire chain is valid, False otherwise
        """
        prev = None
        try:
            with open(path, "r") as f:
                for line_num, line in enumerate(f, 1):
                    if not line.strip():
                        continue
                    entry = json.loads(line)

                    # Reconstruct the payload that was hashed
                    payload = {
                        k: entry[k]
                        for k in ["timestamp", "event_type", "data", "metadata", "prev_hash"]
                    }
                    computed = hashlib.sha256(
                        json.dumps(payload, sort_keys=True).encode("utf-8")
                    ).hexdigest()

                    if computed != entry["hash"]:
                        return False
                    if entry["prev_hash"] != prev:
                        return False

                    prev = entry["hash"]
        except (FileNotFoundError, json.JSONDecodeError, KeyError):
            return False

        return True

    def read_all(self):
        """Yield all entries in order."""
        try:
            with open(self.path, "r") as f:
                for line in f:
                    if line.strip():
                        yield json.loads(line)
