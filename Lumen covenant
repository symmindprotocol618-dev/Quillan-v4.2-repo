"""
Minimal demonstration: audit-logged inference with hardware veto.

Run:
    python demo.py

Produces:
    audit_log.jsonl — a hash-chained ledger of all inference steps

Verify:
    The script verifies chain integrity automatically on completion.
    You can also verify independently:
        python -c "from chronicle import Chronicle; print(Chronicle.verify('audit_log.jsonl'))"
"""

import os
import random
from chronicle import Chronicle
from hardware_trigger import HardwareTrigger, LatchState


def run_demo(seed: int = 42, steps: int = 10, threshold: float = 0.8):
    """
    Simulate inference steps with audit logging and hardware veto.

    Args:
        seed: Random seed for reproducibility
        steps: Number of inference steps to simulate
        threshold: Risk score at or above which the hardware veto fires
    """
    random.seed(seed)
    ledger_path = "audit_log.jsonl"

    # Clean slate for reproducibility
    if os.path.exists(ledger_path):
        os.remove(ledger_path)

    chronicle = Chronicle(ledger_path)
    trigger = HardwareTrigger(threshold=threshold)

    # Log session start
    chronicle.append(
        event_type="SESSION_START",
        data={
            "seed": seed,
            "steps": steps,
            "threshold": threshold,
        },
    )

    print(f"Running {steps} inference steps (seed={seed}, veto threshold={threshold})")
    print("-" * 60)

    halted = False
    for step in range(steps):
        # Simulate a risk assessment (in production, this comes from upstream classifiers)
        risk = round(random.random(), 4)
        state = trigger.evaluate(risk)

        # Log every step — this is the whole point
        chronicle.append(
            event_type="INFERENCE_STEP",
            data={
                "step": step,
                "risk_score": risk,
                "latch_state": state.value,
            },
        )

        print(f"  Step {step:>2}: risk={risk:.4f}  state={state.value}")

        if state == LatchState.TRIGGERED:
            chronicle.append(
                event_type="SYSTEM_HALT",
                data={
                    "reason": "Hardware veto engaged",
                    "trigger_step": step,
                    "trigger_risk": risk,
                },
            )
            print(f"\n  *** HARDWARE VETO at step {step} (risk={risk:.4f} >= {threshold}) ***")
            halted = True
            break

    if not halted:
        print(f"\n  All {steps} steps completed without veto.")

    # Log session end
    chronicle.append(
        event_type="SESSION_END",
        data={
            "steps_completed": step + 1 if not halted else step,
            "halted": halted,
        },
    )

    # Verify chain integrity
    print("-" * 60)
    valid = Chronicle.verify(ledger_path)
    print(f"Ledger integrity: {'VALID' if valid else 'CORRUPTED'}")
    print(f"Ledger location:  {os.path.abspath(ledger_path)}")

    # Show what's in the ledger
    entries = list(Chronicle(ledger_path).read_all())
    print(f"Total entries:    {len(entries)}")

    return valid


if __name__ == "__main__":
    run_demo()
